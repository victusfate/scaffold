// Generated by scripts/render-c4.ts from ../explorer/agentic-task-queue.explorer.json. Edit the spec, then run it again.
workspace "Agentic task queue" "Takes work from several sources and has one worker run each task in isolation. A design: not every part is built." {

    model {
        p_owner = person "Owner" "Adds work with /queue ingest and selects which assistant proposals enter the queue."
        s_github = softwareSystem "GitHub" "Holds the queue: one task is one issue, with status, priority and project labels." "External"
        s_target = softwareSystem "Target repo" "The repository a task changes; work merges back into its integration branch." "External"
        sys = softwareSystem "Agentic task queue" "Takes work from several sources and has one worker run each task in isolation. A design: not every part is built." {
            group "Dispatch" {
                c_ING = container "Ingestion sources" "Three ways work enters the queue as issues: a person running /queue ingest, automated watchers and cron hooks, and assistant proposals that wait for a human to select them."
                c_DISP = container "Dispatch layer" "Stores every task as a GitHub issue for all projects, triggers workers by schedule or by event, and hands each task to one worker through an assign, verify and lease claim; a rare double claim is possible."
            }
            group "Execution" {
                c_WORK = container "Workers" "The agents that claim and execute tasks: Claude routines and manual pulls in phase 1, with GitHub Action crons added in phase 2."
                c_EXEC = container "Execution layer" "Runs one claimed task in its own worktree in the task's target repo, validates it, and merges it back into the integration branch, sending conflicts to an agent-driven reconciliation task."
            }
        }

        p_owner -> c_ING "Asks for work"
        c_ING -> c_DISP "Work enters the queue"
        c_DISP -> s_github "Stores each task as an issue"
        c_DISP -> c_WORK "Claimed by one worker"
        c_WORK -> c_EXEC "Target repo checked out"
        c_EXEC -> s_target "Merges back into the integration branch"
        c_EXEC -> s_github "Marks the issue completed"
    }

    views {
        systemContext sys "context" {
            include *
            autoLayout lr
        }
        container sys "containers" {
            include *
            autoLayout lr
        }
        dynamic sys "v_main" "Ingestion to merge-back" {
            p_owner -> c_ING "Asks for work"
            c_ING -> c_DISP "Work enters the queue"
            c_DISP -> s_github "Stores each task as an issue"
            c_DISP -> c_WORK "Claimed by one worker"
            c_WORK -> c_EXEC "Target repo checked out"
            c_EXEC -> s_target "Merges back into the integration branch"
            c_EXEC -> s_github "Marks the issue completed"
            autoLayout lr
        }
        styles {
            element "Person" {
                shape Person
                background #08427b
                color #ffffff
            }
            element "Software System" {
                background #1168bd
                color #ffffff
            }
            element "Container" {
                background #438dd5
                color #ffffff
            }
            element "Component" {
                background #85bbf0
                color #000000
            }
            element "External" {
                background #999999
                color #ffffff
            }
            element "Database" {
                shape Cylinder
            }
            element "Queue" {
                shape Pipe
            }
        }
    }
}
