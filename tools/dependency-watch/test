#!/usr/bin/env node
// Acceptance tests for tools/dependency-watch/run — detect and emit in temp git repos.

import { spawnSync, execFileSync } from 'node:child_process';
import { mkdtempSync, writeFileSync, mkdirSync, readFileSync, existsSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = dirname(fileURLToPath(import.meta.url));
const RUN = join(HERE, 'run');

let passed = 0, failed = 0;
function assert(label, cond, detail = '') {
  if (cond) { console.error(`  pass  ${label}`); passed++; }
  else { console.error(`  FAIL  ${label}${detail ? ' — ' + detail : ''}`); failed++; }
}
const show = v => JSON.stringify(v);

function repoWith(files) {
  const dir = mkdtempSync(join(tmpdir(), 'dependency-watch-'));
  execFileSync('git', ['init', '-q'], { cwd: dir });
  for (const [path, content] of Object.entries(files)) {
    mkdirSync(dirname(join(dir, path)), { recursive: true });
    writeFileSync(join(dir, path), content);
  }
  if (Object.keys(files).length) execFileSync('git', ['add', ...Object.keys(files)], { cwd: dir });
  return dir;
}
function run(args) {
  const r = spawnSync(process.execPath, [RUN, ...args], { encoding: 'utf8' });
  let json = null;
  try { json = JSON.parse(r.stdout); } catch { /* status asserted by callers */ }
  return { status: r.status, json, stderr: r.stderr };
}
const stateOf = (json, path) => json.files.find(f => f.path === path)?.state;

const WORKFLOW = '.github/workflows/dependency-watch.yml';
const DEPENDABOT = '.github/dependabot.yml';
const CHECK = '.github/dependency-watch/runtime-check.ts';

// ── Slice 7: detect ─────────────────────────────────────────────────────────
const APP = {
  'Gemfile.lock': 'GEM\n',
  'web/package-lock.json': '{}\n',
  'web/yarn.lock': '\n',
  'svc/go.mod': 'module x\n',
  'tools/requirements-dev.txt': 'x\n',
  'test/fixtures/Cargo.lock': '\n',
  '.github/workflows/ci.yml': 'on: push\n',
  '.ruby-version': '3.4.12\n',
  'Dockerfile': 'FROM node:26-slim\n',
};
{
  const repo = repoWith(APP);
  const r = run(['--detect-only', '--into', repo]);
  assert('detect exits 0 with JSON', r.status === 0 && r.json, `${r.status} ${r.stderr}`);
  assert('ecosystems with directories; fixtures ignored', show(r.json?.ecosystems) === show([
    { ecosystem: 'bundler', directories: ['/'] },
    { ecosystem: 'github-actions', directories: ['/'] },
    { ecosystem: 'gomod', directories: ['/svc'] },
    { ecosystem: 'npm', directories: ['/web'] },
    { ecosystem: 'pip', directories: ['/tools'] },
  ]), show(r.json?.ecosystems));
  assert('runtime pins listed', show(r.json?.runtimePins) === show([
    { file: '.ruby-version', line: 1, runtime: 'ruby', state: 'exact' },
    { file: 'Dockerfile', line: 1, runtime: 'node', state: 'floating' },
  ]), show(r.json?.runtimePins));
  assert('fresh repo: every file is none', r.json?.files.length >= 3 && r.json.files.every(f => f.state === 'none'), show(r.json?.files));
  assert('detect writes nothing', !existsSync(join(repo, WORKFLOW)) && !existsSync(join(repo, DEPENDABOT)));
}
{
  const repo = repoWith({ ...APP, [DEPENDABOT]: 'version: 2\nupdates: []\n' });
  const r = run(['--detect-only', '--into', repo]);
  assert('hand-written dependabot.yml is foreign', stateOf(r.json, DEPENDABOT) === 'foreign', show(r.json?.files));
}

// ── Slice 8: emit ───────────────────────────────────────────────────────────

console.error(`\n${passed} passed, ${failed} failed`);
if (failed) process.exit(1);
