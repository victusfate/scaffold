{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/session-start/hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/read-once/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" || exit 0"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/read-once/compact.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "modern-web-guidance@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npx -y modern-web-guidance@latest:*)",
      "Bash(pnpx modern-web-guidance@latest:*)"
    ]
  }
}
